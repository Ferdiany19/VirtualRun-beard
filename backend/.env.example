NODE_ENV=development
APP_URL=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Jakarta
DATABASE_URL=postgres://postgres:123123@localhost:5432/virtual_run_beard

ADMIN_SESSION_COOKIE_NAME=vrb_admin_session
ADMIN_CSRF_COOKIE_NAME=vrb_admin_csrf
SESSION_SECRET=replace-with-at-least-32-random-characters
TURNSTILE_SECRET_KEY=
TURNSTILE_DEVELOPMENT_BYPASS=false

DEV_ADMIN_EMAIL=admin@beard.test
DEV_ADMIN_PASSWORD=ChangeMe!2026
PARTICIPANT_SESSION_COOKIE_NAME=vrb_participant_session
PARTICIPANT_CSRF_COOKIE_NAME=vrb_participant_csrf

STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=../.local-storage
BIB_TEMPLATE_MAX_BYTES=4000000
SUBMISSION_SCREENSHOT_MAX_BYTES=6000000
REVIEW_CLAIM_DURATION_MINUTES=30
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=virtual-run-beard
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

EMAIL_DRIVER=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

BACKUP_DIR=/var/backups/virtual-run-beard
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_PASSWORD=
GDRIVE_REMOTE=gdrive
GDRIVE_BACKUP_PATH=VirtualRunBeard/backups
